classDiagram
    direction TB

    namespace dungeonforge_behavior {
        class Action {
            -Type type
            -Entity target
            -String flavor
            +Action(Type type, Entity target, String flavor)
            +getType() Type
            +getTarget() Entity
            +getFlavor() String
            +wait(String flavor) Action$
        }

        class ActionType {
            <<enumeration>>
            ATTACK
            RANGED_ATTACK
            FLEE
            HEAL_ALLY
            WAIT
        }

        class CombatStrategy {
            <<interface>>
            +chooseAction(Monster self, Player player, Room room) Action
            +name() String
        }

        class AggressiveStrategy {
            +chooseAction(Monster self, Player player, Room room) Action
            +name() String
        }

        class HealerStrategy {
            +chooseAction(Monster self, Player target, Room room) Action
            +name() String
        }

        class RangedStrategy {
            +chooseAction(Monster self, Player target, Room room) Action
            +name() String
        }

        class SkittishStrategy {
            +chooseAction(Monster self, Player target, Room room) Action
            +name() String
        }
    }

    namespace dungeonforge_commands {
        class Command {
            <<interface>>
            +execute() void
            +undo() void
            +getDescription() String
            +isUndoable() boolean
            +endsTurn() boolean
        }

        class CommandFactory {
            <<interface>>
            +create(GameContext ctx, String args) Command
        }

        class AbstractCommand {
            <<abstract>>
            #GameContext ctx
            #String args
            -boolean actuallyRan
            -TurnSnapshot snapshot
            +AbstractCommand(GameContext ctx, String args)
            +player() Player
            +bus() EventBus
            +room() Room
            +execute() void
            #doExecute() boolean
            +undo() void
            +isUndoable() boolean
            +getDescription() String
        }

        class AttackCommand {
            +AttackCommand(GameContext ctx, String args)
            #doExecute() boolean
            -findTarget() Monster
            +getDescription() String
        }

        class DropCommand {
            +DropCommand(GameContext ctx, String args)
            #doExecute() boolean
            +getDescription() String
        }

        class MoveCommand {
            -String direction
            +MoveCommand(GameContext ctx, String direction)
            #doExecute() boolean
            +getDescription() String
        }

        class TakeCommand {
            +TakeCommand(GameContext ctx, String args)
            #doExecute() boolean
            -takeFromFloor() Item
            -takeFromChest() Item
            -matches(Item item) boolean
            +getDescription() String
        }

        class UseItemCommand {
            +UseItemCommand(GameContext ctx, String args)
            #doExecute() boolean
            +getDescription() String
        }

        class NoCommand {
            -EventBus bus
            -String reason
            +NoCommand(EventBus bus, String reason)
            +execute() void
            +undo() void
            +getDescription() String
            +isUndoable() boolean
            +endsTurn() boolean
        }

        class SimpleCommand {
            -String description
            -Body body
            +SimpleCommand(String description, Body body)
            +execute() void
            +undo() void
            +getDescription() String
            +isUndoable() boolean
            +endsTurn() boolean
        }

        class Body {
            <<interface>>
            +run() void
        }

        class MacroCommand {
            -List~Command~ children
            -String description
            +MacroCommand(String description, List~Command~ children)
            +execute() void
            +undo() void
            +getDescription() String
            +endsTurn() boolean
            +size() int
        }

        class CommandHistory {
            -Deque~Command~ undoStack
            -List~String~ replaying
            -int maxDepth
            +CommandHistory()
            +push(Command command) void
            +undoLast() boolean
            +depth() int
            +replayLog() List~String~
            +clear() void
        }

        class CommandParser {
            -Map~String,CommandFactory~ registry
            -Map~String,String~ aliases
            -QuestTracker quests
            -AchievementSystem achievements
            +CommandParser(QuestTracker quests, AchievementSystem achievements)
            +register(String verb, CommandFactory factory) void
            +alias(String shortForm, String verb) void
            +verbs() List~String~
            +parse(String input, GameContext ctx) Command
            -registerDefaults() void
            -createLootCommand(GameContext ctx, String ignored) Command
            +describeRoom(GameContext ctx) String
        }

        class GameContext {
            -EventBus bus
            -GameWorld world
            -Player player
            -Combat combat
            -CommandHistory history
            -Room currentRoom
            -boolean running
            +GameContext(GameWorld world, Player player, EventBus bus, Combat combat, CommandHistory history)
            +getBus() EventBus
            +getWorld() GameWorld
            +getPlayer() Player
            +getCombat() Combat
            +getHistory() CommandHistory
            +getCurrentRoom() Room
            +setCurrentRoom(Room currentRoom) void
            +isRunning() boolean
            +stop() void
            +runMonsterTurns() void
        }

        class TurnSnapshot {
            -Player player
            -Room room
            -int hp
            -int xp
            -int gold
            -List~Item~ inventory
            -List~Monster~ monsters
            -List~Item~ floorItems
            -List~Item~ chestContents
            -Map~Monster,Integer~ monsterHp
            -Map~Monster,CombatStrategy~ monsterStrategies
            -TurnSnapshot(Player player, Room room)
            +capture(Player player, Room room) TurnSnapshot$
            +restore() void
            +getRoom() Room
            +getPlayer() Player
        }
    }

    namespace dungeonforge_config {
        class GameConfig {
            <<final>>
            -GameConfig instance$
            -Map~String,Object~ settings
            -GameConfig()
            +getInstance() GameConfig$
            -loadDefaults() void
            -loadFromClasspath(String resourceName) void
            +readResource(String resourceName) String$
            +getInt(String key) int
            +getDouble(String key) double
            +getSeed() long
            +resetForTests() void$
        }

        class Json {
            <<final>>
            -String s
            -int i
            -Json(String s)
            +parseObject(String text) Map~String,Object~$
            -ws() void
            -value() Object
            -object() Map~String,Object~
            -array() List~Object~
            -string() String
            -number() Double
        }

        class RandomSource {
            <<final>>
            -RandomSource instance$
            -Random rng
            -long seed
            -RandomSource()
            +getInstance() RandomSource$
            +nextInt(int bound) int
            +between(int lo, int hi) int
            +nextDouble() double
            +pick(List~T~ options) T
            +pick(T[] options) T
            +getSeed() long
            +reseed(long newSeed) void
            +resetForTests() void$
        }
    }

    namespace dungeonforge_core {
        class Entity {
            <<abstract>>
            #String name
            #int hp
            #int maxHp
            #int attackPower
            #int defense
            #Entity(String name, int maxHp, int attackPower, int defense)
            +getName() String
            +getHp() int
            +getMaxHp() int
            +getAttackPower() int
            +getDefense() int
            +isAlive() boolean
            +setHp(int hp) void
            +takeDamage(int amount) void
            +heal(int amount) void
            +describe() String
            +toString() String
        }

        class Player {
            -int gold
            -int xp
            -List~Item~ inventory
            +Player(String name)
            +getInventory() List~Item~
            +addItem(Item item) void
            +removeItem(Item item) boolean
            +findItem(String query) Item
            +setGold(int gold) void
            +setXp(int xp) void
            +getGold() int
            +getXp() int
            +addGold(int gold) void
            +addXp(int xp) void
            +carryCapacity() double
            +describe() String
        }

        class Monster {
            -String species
            -int xpReward
            -CombatStrategy strategy
            +Monster(String species, int maxHp, int attackPower, int xpReward)
            +getStrategy() CombatStrategy
            +setStrategy(CombatStrategy strategy) void
            +getSpecies() String
            +getXpReward() int
            +hpFraction() double
            +describe() String
        }

        class Combat {
            -EventBus bus
            -int MAX_ROUNDS$
            +Combat(EventBus bus)
            +monsterTurns(Player player, Room room) void
            +playerStrikes(Player player, Monster target) void
            +firstLivingIn(Room room) Monster
            -playerActsOn(Player player, Monster target) void
            -checkForTacticsChange(Monster monster) void
            -monsterActs(Monster monster, Player player, Room room) void
            -hasLiving(Room room) boolean
            -firstLiving(Room room) Monster
            -livingMonsters(Room room) List~Monster~
            +restAfterRoom(Player player) void$
        }

        class GameWorld {
            -Player player
            -MonsterFactory monsterFactory
            -ThemeRegistry themes
            -List~DungeonLevel~ levels
            +GameWorld(Player player)
            -generate() void
            -linkRooms() void
            +startingRoom() Room
            +levelContaining(Room room) DungeonLevel
            -populatorFor(ThemeKit theme, boolean isFinalRoom) RoomPopulator
            +getPlayer() Player
            +getLevels() List~DungeonLevel~
            +getMonsterFactory() MonsterFactory
            +getThemes() ThemeRegistry
            +totalMonsters() int
            +totalLoot() int
        }

        class DungeonLevel {
            -int depth
            -String themeName
            -List~Room~ rooms
            +DungeonLevel(int depth, String themeName)
            +getDepth() int
            +getThemeName() String
            +getRooms() List~Room~
            +addRoom(Room room) void
        }

        class Room {
            -String id
            -String flavor
            -List~Monster~ monsters
            -List~Item~ floorItems
            -Chest chest
            -Map~String,Room~ exits
            +Room(String id)
            +getId() String
            +getFlavor() String
            +setFlavor(String flavor) void
            +getMonsters() List~Monster~
            +addMonster(Monster monster) void
            +getFloorItems() List~Item~
            +addItem(Item item) void
            +getExits() Map~String,Room~
            +getExit(String direction) Room
            +link(String direction, Room destination) void
            +firstLivingIn() Monster
            +hasLivingMonsters() boolean
            +getChest() Chest
            +setChest(Chest chest) void
            +hasChest() boolean
        }
    }

    namespace dungeonforge_events {
        class GameEventListener {
            <<interface>>
            +onEvent(GameEvent event) void
        }

        class EventType {
            <<enumeration>>
            DAMAGE_DEALT
            DAMAGE_TAKEN
            MONSTER_DIED
            MONSTER_FLED
            MONSTER_HEALED
            STRATEGY_CHANGED
            XP_GAINED
            GOLD_GAINED
            LEVEL_ENTERED
            ROOM_CLEARED
            PLAYER_DIED
            DELVE_SURVIVED
            MESSAGE
        }

        class GameEvent {
            <<final>>
            -EventType type
            -Map~String,Object~ payload
            +GameEvent(EventType type)
            +getType() EventType
            +of(EventType type, Object[] keyValuePairs) GameEvent$
            +message(String text) GameEvent$
            +get(String key) Object
            +getString(String key) String
            +getInt(String key) int
            +toString() String
        }

        class EventBus {
            -List~GameEventListener~ listeners
            +subscribe(GameEventListener listener) void
            +unsubscribe(GameEventListener listener) void
            +publish(GameEvent event) void
            +message(String text) void
            +listenerCount() int
        }

        class AchievementSystem {
            -Set~String~ unlocked
            -EventBus bus
            -int kills
            -int fled
            -int deepestLevel
            +AchievementSystem(EventBus bus)
            +getUnlocked() Set~String~
            +onEvent(GameEvent event) void
            -unlock(String name, String description) void
        }

        class CombatLog {
            -Deque~String~ lines
            -int maxLines
            +CombatLog(int maxLines)
            +onEvent(GameEvent event) void
            -format(GameEvent event) String
            +getLines() Deque~String~
            +clear() void
            +size() int
        }

        class DangerMeter {
            -EventBus bus
            -Player player
            -int damageThreshold
            +DangerMeter(EventBus bus, Player player, int damageThreshold)
            +onEvent(GameEvent event) void
        }

        class Quest {
            -String id
            -String description
            -EventType trigger
            -int required
            -int progress
            +Quest(String id, String description, EventType trigger, int required)
            +getId() String
            +getDescription() String
            +getTrigger() EventType
            +getRequired() int
            +getProgress() int
            +isComplete() boolean
            +advance() boolean
            +toString() String
        }

        class QuestTracker {
            -List~Quest~ quests
            -EventBus bus
            +QuestTracker(EventBus bus)
            +getQuests() List~Quest~
            +onEvent(GameEvent event) void
            +completedCount() int
        }
    }

    namespace dungeonforge_factory {
        class MonsterDef {
            +String id
            +String name
            +int hp
            +int attack
            +int xp
            +String theme
            +boolean boss
            +String strategy
            +MonsterDef(String id, String name, int hp, int attack, int xp, String theme)
            +MonsterDef(String id, String name, int hp, int attack, int xp, String theme, boolean boss, String strategy)
            +getStrategy() String
            +getId() String
            +getName() String
            +getHp() int
            +getAttack() int
            +getXp() int
            +getTheme() String
            +isBoss() boolean
            +toString() String
        }

        class MonsterFactory {
            -Map~String,MonsterDef~ blueprints
            +MonsterFactory()
            -loadFrom(String resourceName) void
            +register(MonsterDef definition) void
            +create(String id, int depth) Monster
            +idsForTheme(String name) List~String~
            +bossIdFromTheme(String theme) String
            +has(String id) boolean
            +blueprintCount() int
            +strategyFor(String name) CombatStrategy$
            -str(Object value, String fallback) String$
            -num(Object value, int fallback) int$
        }

        class ThemeKit {
            <<interface>>
            +themeName() String
            +createMonster(int depth) Monster
            +createBoss(int depth) Monster
            +createLoot(int depth) Item
            +createRoomFlavor() String
        }

        class CryptThemeKit {
            -MonsterFactory factory
            -String[] FLAVORS$
            +CryptThemeKit(MonsterFactory factory)
            +themeName() String
            +createMonster(int depth) Monster
            +createBoss(int depth) Monster
            +createLoot(int depth) Item
            +createRoomFlavor() String
        }

        class ForgeThemeKit {
            -MonsterFactory factory
            -String[] FLAVORS$
            +ForgeThemeKit(MonsterFactory factory)
            +themeName() String
            +createMonster(int depth) Monster
            +createBoss(int depth) Monster
            +createLoot(int depth) Item
            +createRoomFlavor() String
        }

        class FrostThemeKit {
            -MonsterFactory factory
            -String[] FLAVORS$
            +FrostThemeKit(MonsterFactory factory)
            +themeName() String
            +createMonster(int depth) Monster
            +createBoss(int depth) Monster
            +createLoot(int depth) Item
            +createRoomFlavor() String
        }

        class WinterfellThemeKit {
            -MonsterFactory factory
            -String[] FLAVORS$
            +WinterfellThemeKit(MonsterFactory factory)
            +themeName() String
            +createMonster(int depth) Monster
            +createBoss(int depth) Monster
            +createLoot(int depth) Item
            +createRoomFlavor() String
        }

        class ThemeRegistry {
            <<final>>
            -List~ThemeKit~ kits
            +ThemeRegistry(MonsterFactory factory)
            +forDepth(int depth) ThemeKit
            +size() int
            +themeNames() List~String~
        }

        class RoomPopulator {
            <<abstract>>
            #ThemeKit theme
            #RoomPopulator(ThemeKit theme)
            +populate(Room room, int depth) void
            #createEncounter(int depth) List~Monster~
            #createChest(int depth) Chest
            +kind() String
        }

        class StandardRoomPopulator {
            +StandardRoomPopulator(ThemeKit theme)
            +kind() String
            #createEncounter(int depth) List~Monster~
        }

        class TreasureRoomPopulator {
            +TreasureRoomPopulator(ThemeKit theme)
            +kind() String
            #createEncounter(int depth) List~Monster~
            #createChest(int depth) Chest
        }

        class BossRoomPopulator {
            +BossRoomPopulator(ThemeKit theme)
            #createEncounter(int depth) List~Monster~
            +kind() String
            #createChest(int depth) Chest
        }
    }

    namespace dungeonforge_items {
        class Item {
            <<interface>>
            +getName() String
            +getWeight() double
            +getValue() int
            +describe() String
        }

        class Armor {
            -String name
            -double weight
            -int value
            -int defense
            +Armor(String name, double weight, int value, int defense)
            +getName() String
            +getWeight() double
            +getValue() int
            +getDefense() int
            +describe() String
        }

        class Potion {
            -String name
            -double weight
            -int value
            -int healAmount
            +Potion(String name, double weight, int value, int healAmount)
            +getName() String
            +getWeight() double
            +getValue() int
            +getHealAmount() int
            +describe() String
        }

        class Treasure {
            -String name
            -double weight
            -int value
            +Treasure(String name, double weight, int value)
            +getName() String
            +getWeight() double
            +getValue() int
        }

        class Weapon {
            -String name
            -double weight
            -int value
            -int damage
            +Weapon(String name, double weight, int value, int damage)
            +getName() String
            +getWeight() double
            +getValue() int
            +getDamage() int
            +describe() String
        }

        class Hourglass {
            -int charges
            +Hourglass(int charges)
            +getCharges() int
            +hasCharges() boolean
            +spendCharges() void
            +getName() String
            +getWeight() double
            +getValue() int
            +describe() String
        }

        class Chest {
            -String name
            -List~Item~ contents
            +Chest(String name)
            +getName() String
            +getContents() List~Item~
            +add(Item item) void
            +isEmpty() boolean
            +totalValue() int
        }
    }

    namespace dungeonforge_main {
        class Main {
            <<final>>
            +String VERSION$
            -Main()
            +banner() String$
            +main(String[] args) void$
            -runScript(CommandParser commands, GameContext context, CommandHistory history, List~String~ lines) void$
            -gameLoop(CommandParser parser, GameContext context) void$
        }

        class ConsolePrinter {
            -CombatLog formatter
            +onEvent(GameEvent event) void
        }
    }

    CombatStrategy <|.. AggressiveStrategy
    CombatStrategy <|.. HealerStrategy
    CombatStrategy <|.. RangedStrategy
    CombatStrategy <|.. SkittishStrategy

    Action --> ActionType : type
    Action --> Entity : target

    Command <|.. AbstractCommand
    Command <|.. NoCommand
    Command <|.. SimpleCommand
    Command <|.. MacroCommand

    AbstractCommand <|-- AttackCommand
    AbstractCommand <|-- DropCommand
    AbstractCommand <|-- MoveCommand
    AbstractCommand <|-- TakeCommand
    AbstractCommand <|-- UseItemCommand

    SimpleCommand *-- Body : body
    MacroCommand *-- "0..*" Command : children
CommandHistory o-- "0..*" Command : undo stack
CommandParser *-- "0..*" CommandFactory : registry
CommandParser --> QuestTracker : quests
CommandParser --> AchievementSystem : achievements
CommandFactory ..> Command : creates
CommandFactory ..> GameContext : receives

AbstractCommand --> GameContext : context
AbstractCommand *-- TurnSnapshot : snapshot
AttackCommand ..> Monster : targets
DropCommand ..> Item : drops
MoveCommand ..> Room : moves to
TakeCommand ..> Item : takes
UseItemCommand ..> Item : uses
UseItemCommand ..> Potion : consumes
UseItemCommand ..> Hourglass : rewinds

GameContext --> EventBus : bus
GameContext --> GameWorld : world
GameContext --> Player : player
GameContext --> Combat : combat
GameContext --> CommandHistory : history
GameContext --> Room : current room

TurnSnapshot --> Player : snapshots
TurnSnapshot --> Room : snapshots
TurnSnapshot o-- "0..*" Item : saved items
TurnSnapshot o-- "0..*" Monster : saved monsters
TurnSnapshot o-- "0..*" CombatStrategy : saved strategies

GameConfig ..> Json : parses configuration
RandomSource ..> GameConfig : reads seed

Entity <|-- Player
Entity <|-- Monster
Monster --> CombatStrategy : strategy
Player *-- "0..*" Item : inventory

Combat --> EventBus : publishes through
Combat ..> Action : resolves
Combat ..> Monster : controls
Combat ..> Player : affects
Combat ..> Room : resolves
Combat ..> SkittishStrategy : changes tactics
Combat ..> GameConfig : reads settings

GameWorld --> Player : player
GameWorld *-- MonsterFactory : factory
GameWorld *-- ThemeRegistry : themes
GameWorld *-- "1..*" DungeonLevel : levels
GameWorld ..> RoomPopulator : selects
GameWorld ..> ThemeKit : requests products
GameWorld ..> RandomSource : selects population
GameWorld ..> GameConfig : reads settings

DungeonLevel *-- "0..*" Room : rooms
Room *-- "0..*" Monster : monsters
Room *-- "0..*" Item : floor items
Room *-- Chest : chest
Room o-- "0..*" Room : exits

GameEventListener <|.. AchievementSystem
GameEventListener <|.. CombatLog
GameEventListener <|.. DangerMeter
GameEventListener <|.. QuestTracker
GameEventListener <|.. ConsolePrinter

EventBus o-- "0..*" GameEventListener : listeners
EventBus ..> GameEvent : publishes
GameEvent --> EventType : type
AchievementSystem --> EventBus : reports through
CombatLog ..> GameEvent : formats
DangerMeter --> EventBus : reports through
DangerMeter --> Player : monitors
QuestTracker *-- "0..*" Quest : quests
QuestTracker --> EventBus : reports through
Quest --> EventType : trigger

MonsterFactory *-- "0..*" MonsterDef : blueprints
MonsterFactory ..> Monster : creates
MonsterFactory ..> Json : parses data
MonsterFactory ..> GameConfig : reads resource
MonsterFactory ..> RandomSource : varies stats
MonsterFactory ..> CombatStrategy : assigns strategy
MonsterFactory ..> AggressiveStrategy : creates
MonsterFactory ..> HealerStrategy : creates
MonsterFactory ..> RangedStrategy : creates
MonsterFactory ..> SkittishStrategy : creates

ThemeKit <|.. CryptThemeKit
ThemeKit <|.. ForgeThemeKit
ThemeKit <|.. FrostThemeKit
ThemeKit <|.. WinterfellThemeKit

CryptThemeKit --> MonsterFactory : factory
ForgeThemeKit --> MonsterFactory : factory
FrostThemeKit --> MonsterFactory : factory
WinterfellThemeKit --> MonsterFactory : factory

CryptThemeKit ..> RandomSource : uses
ForgeThemeKit ..> RandomSource : uses
FrostThemeKit ..> RandomSource : uses
WinterfellThemeKit ..> RandomSource : uses

CryptThemeKit ..> Weapon : creates
CryptThemeKit ..> Armor : creates
CryptThemeKit ..> Potion : creates
CryptThemeKit ..> Treasure : creates

ForgeThemeKit ..> Weapon : creates
ForgeThemeKit ..> Armor : creates
ForgeThemeKit ..> Potion : creates
ForgeThemeKit ..> Treasure : creates

FrostThemeKit ..> Weapon : creates
FrostThemeKit ..> Armor : creates
FrostThemeKit ..> Potion : creates
FrostThemeKit ..> Treasure : creates

WinterfellThemeKit ..> Weapon : creates
WinterfellThemeKit ..> Armor : creates
WinterfellThemeKit ..> Potion : creates
WinterfellThemeKit ..> Treasure : creates

ThemeRegistry *-- "1..*" ThemeKit : kits
ThemeRegistry ..> CryptThemeKit : creates
ThemeRegistry ..> ForgeThemeKit : creates
ThemeRegistry ..> FrostThemeKit : creates
ThemeRegistry ..> WinterfellThemeKit : creates

RoomPopulator <|-- StandardRoomPopulator
RoomPopulator <|-- TreasureRoomPopulator
RoomPopulator <|-- BossRoomPopulator
RoomPopulator --> ThemeKit : theme
RoomPopulator ..> Room : populates
RoomPopulator ..> Monster : creates encounter
RoomPopulator ..> Chest : creates

StandardRoomPopulator ..> GameConfig : reads maximum
StandardRoomPopulator ..> RandomSource : chooses count
TreasureRoomPopulator ..> RandomSource : chooses loot count

Item <|.. Armor
Item <|.. Potion
Item <|.. Treasure
Item <|.. Weapon
Item <|.. Hourglass
Chest *-- "0..*" Item : contents

Main ..> RandomSource : configures seed
Main ..> Player : creates
Main ..> Potion : creates
Main ..> Hourglass : creates
Main ..> GameWorld : creates
Main ..> EventBus : creates
Main ..> QuestTracker : creates
Main ..> AchievementSystem : creates
Main ..> CombatLog : creates
Main ..> CommandHistory : creates
Main ..> GameContext : creates
Main ..> CommandParser : creates
Main ..> Combat : creates
Main ..> Command : executes
Main *-- ConsolePrinter : nested class
ConsolePrinter *-- CombatLog : formatter